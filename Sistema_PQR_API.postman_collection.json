  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login exitoso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
                  "    console.log(\"Token guardado correctamente.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.pqr@test.com\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Autenticarse utilizando el usuario administrador creado por el seed. El token JWT se guarda automáticamente en la variable access_token."
          },
          "response": []
        },
        {
          "name": "Usuario Actual",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Usuario autenticado correctamente\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Obtener información del usuario autenticado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "PQR - CRUD Principal",
      "item": [
        {
          "name": "Crear PQR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"PQR creada correctamente\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set(\"pqr_id\", jsonData.id);",
                  "    }",
                  "    if (jsonData.radicado) {",
                  "        pm.collectionVariables.set(\"radicado\", jsonData.radicado);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitante\": {\n    \"nombre\": \"María\",\n    \"apellido\": \"Gómez\",\n    \"tipo_documento\": \"CC\",\n    \"numero_documento\": \"9876543210\",\n    \"email\": \"maria.gomez@email.com\",\n    \"telefono\": \"3009876543\"\n  },\n  \"tipo\": \"peticion\",\n  \"titulo\": \"Solicitud de información\",\n  \"descripcion\": \"Necesito información sobre los servicios disponibles.\",\n  \"categoria\": \"Atención al usuario\",\n  \"prioridad\": \"media\",\n  \"canal\": \"web\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pqr",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pqr"
              ]
            },
            "description": "Registrar una nueva PQR. El ID y radicado de la PQR creada se guardan automáticamente en las variables pqr_id y radicado."
          },
          "response": []
        },
        {
          "name": "Listar PQR (con filtros)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pqr?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pqr"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "",
                  "description": "recibida, en_gestion, resuelta, cerrada"
                },
                {
                  "key": "tipo",
                  "value": "",
                  "description": "peticion, queja, reclamo"
                },
                {
                  "key": "prioridad",
                  "value": "",
                  "description": "baja, media, alta, urgente"
                },
                {
                  "key": "categoria",
                  "value": "",
                  "description": "Categoría de la PQR"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número de página"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Registros por página. Máximo 100."
                }
              ]
            },
            "description": "Listar PQR con filtros opcionales. Requiere autenticación."
          },
          "response": []
        },
        {
          "name": "Buscar PQR por Radicado",
